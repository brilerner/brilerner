---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: "PhD candidate",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Duke University",
  },
  sameAs: [site.scholar, site.github, site.linkedin, site.orcid],
  knowsAbout: [
    "Machine learning for healthcare",
    "Multimodal machine learning",
    "Traumatic brain injury",
    "Medical imaging",
    "Interpretability",
  ],
};
---

<BaseLayout jsonLd={personJsonLd} pageClass="home-page">
  <section class="home-intro" aria-labelledby="home-heading">
    <p class="eyebrow">Research and writing</p>
    <h1 id="home-heading">I build machine learning systems around how care actually works.</h1>

    <div class="summary-prose">
      <p>
        I'm a PhD candidate at Duke working on machine learning for healthcare. I build
        multimodal models for traumatic brain injury care, along with architectures and
        methods designed to be interpretable. I also focus strongly on qualitative research:
        interviewing and shadowing providers so that what we build is grounded in how care
        actually works.
      </p>
      <p>
        Outside of research, I pitch on a softball team and am a long-suffering Mets fan. I
        occasionally write about my interests, academic and otherwise, in the{" "}
        <a href="/writing/">blog</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-intro {
    padding-top: 48px;
  }

  h1 {
    max-width: 18ch;
    margin: 0 0 44px;
    font: 500 1.75rem/1.22 "Newsreader", serif;
  }

  .summary-prose {
    max-width: 66ch;
    font: 400 1.375rem/1.62 "Newsreader", serif;
  }

  .summary-prose p {
    margin: 0 0 1.15em;
  }

  @media (max-width: 719px) {
    .home-intro {
      padding-top: 4px;
    }

    h1 {
      margin-bottom: 32px;
    }

    .summary-prose {
      font-size: 1.25rem;
      line-height: 1.58;
    }
  }
</style>
